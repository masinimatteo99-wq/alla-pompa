    "publication:check": "node scripts/publication-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@fontsource/roboto-mono": "^5.3.0",
    "idb": "^8.0.4"
  }
}
